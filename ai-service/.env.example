# Copy to your deployment environment; never commit real values.
# Required: OpenAI API key (server-side secret, not a cBot parameter).
OPENAI_API_KEY=
# Use a model enabled for your OpenAI API project.
OPENAI_MODEL=
# Random, long client token configured separately in the cBot instance.
AI_CLIENT_TOKEN=
# TLS certificate/key paths for a WSS listener. Keep private key outside repository.
TLS_CERT_PATH=/run/secrets/fullchain.pem
TLS_KEY_PATH=/run/secrets/privkey.pem
# cTrader Cloud connection endpoint must be reachable on port 25345.
PORT=25345
