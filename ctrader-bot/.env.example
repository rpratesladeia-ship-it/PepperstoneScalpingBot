# Configure these as secret environment variables on the hosting service.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
# Must exactly match the Redirect URI registered in the cTrader Open API application.
CTRADER_REDIRECT_URI=https://YOUR-SERVICE.onrender.com/oauth/callback
# Generate a long random value; never commit the real value.
SESSION_SECRET=replace-with-a-long-random-secret
